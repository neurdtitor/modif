+/* --------------------------- buffer list management ------------------------ */
+
+/* One active buffer lives in E.buf, the full set in E.bl->bufs[]. While a
+ * buffer is active it is edited through E.buf; buf_sync() pushes it (plus view
+ * state) back into its slot before switching, buf_load() pulls another slot in.
+ * The undo log stays in the base: one global linear history, reset when the
+ * active buffer changes, so it never grows stale across buffers. */
+
+static void buf_sync(void) {
+    if (!E.bl || !E.bl->n) return;
+    Buffer *b = &E.bl->bufs[E.bl->cur];
+    b->cur = E.cur;
+    b->top = E.top;
+    b->left = E.left;
+    b->mark = E.mark;
+    b->dirty = E.dirty;
+}
+
+static void buf_load(size_t i) {
+    Buffer *b = &E.bl->bufs[i];
+    E.bl->cur = i;
+    E.buf = *b;
+    E.cur = b->cur;
+    E.top = b->top;
+    E.left = b->left;
+    E.mark = b->mark;
+    E.dirty = b->dirty;
+    for (size_t k = 0; k < un; k++) free(ustack[k].data); /* fresh undo per buffer */
+    un = 0;
+    upos = 0;
+}
+
+static void buf_add(Buffer *nb) {
+    buf_sync();
+    bl_add(E.bl, nb);
+    buf_load(E.bl->cur);
+}
+
+static void buf_switch(int dir) {
+    if (E.bl->n < 2) return;
+    buf_sync();
+    bl_switch(E.bl, dir);
+    buf_load(E.bl->cur);
+}
+
+void cmd_buf_prev(void) { buf_switch(-1); }
+void cmd_buf_next(void) { buf_switch(1); }
+
+static void buf_new(void) {
+    Buffer nb;
+    buf_init(&nb);
+    buf_build_lines(&nb);
+    buf_add(&nb);
+}
+
+static void buf_close(int force) {
+    if (E.dirty && !force) {
+        edit_set_status("no write since last change (use :bd! / :q!)");
+        return;
+    }
+    if (E.bl->n == 1) {
+        buf_sync();
+        bl_remove(E.bl, E.bl->cur);
+        g_quit = 1;
+        return;
+    }
+    buf_sync();
+    bl_remove(E.bl, E.bl->cur);
+    buf_load(E.bl->cur);
+}
+
+static void buf_list(void) {
+    buf_sync();
+    char tmp[160];
+    size_t off = 0;
+    off += (size_t)snprintf(tmp + off, sizeof tmp - off, "%zu buffer(s):", E.bl->n);
+    for (size_t i = 0; i < E.bl->n && off < sizeof tmp; i++) {
+        const char *n = E.bl->bufs[i].name ? E.bl->bufs[i].name : "[no name]";
+        off += (size_t)snprintf(tmp + off, sizeof tmp - off, " %zu%s%s%s",
+                                i + 1, i == E.bl->cur ? "%" : "", n,
+                                E.bl->bufs[i].dirty ? "*" : "");
+    }
+    edit_set_status("%s", tmp);
+}
