+/* --------------------------- buffer list extras ---------------------------- */
+
+/* Save a specific buffer (possibly not the active one). */
+static void save_buffer(Buffer *b) {
+    if (!b->name) {
+        edit_set_status("no file name");
+        return;
+    }
+    if (buf_save(b) == 0) {
+        b->dirty = 0;
+        if (b == &E.buf) E.dirty = 0;
+        edit_set_status("saved %s (%zu bytes)", b->name, gb_len(&b->gb));
+    } else {
+        edit_set_status("write error: %s", strerror(errno));
+    }
+}
+
+static void buf_new(void) {
+    Buffer nb;
+    buf_init(&nb);
+    buf_build_lines(&nb);
+    buf_add(&nb);
+}
+
+static void buf_close(int force) {
+    if (E.dirty && !force) {
+        edit_set_status("no write since last change (use :bd! / :q!)");
+        return;
+    }
+    if (E.bl->n == 1) {
+        buf_sync();
+        bl_remove(E.bl, E.bl->cur);
+        g_quit = 1;
+        return;
+    }
+    buf_sync();
+    bl_remove(E.bl, E.bl->cur);
+    buf_load(E.bl->cur);
+}
+
+/* ------------------------- quit all + save prompts ------------------------ */
+
+static size_t pp_idx; /* buffer index being prompted, SIZE_MAX = none */
+
+static void save_all(void) {
+    buf_sync();
+    for (size_t i = 0; i < E.bl->n; i++)
+        if (E.bl->bufs[i].dirty) {
+            if (i == E.bl->cur) cmd_save();
+            else save_buffer(&E.bl->bufs[i]);
+        }
+    buf_sync();
+}
+
+/* Quit every buffer. Unless force, ask about each unsaved buffer first. */
+static void quit_all(int force) {
+    buf_sync();
+    if (!force)
+        for (size_t i = 0; i < E.bl->n; i++)
+            if (E.bl->bufs[i].dirty) {
+                pp_idx = i;
+                E.mode = MODE_PROMPT;
+                return;
+            }
+    g_quit = 1;
+}
+
+static void prompt_next(void) {
+    for (size_t i = pp_idx + 1; i < E.bl->n; i++)
+        if (E.bl->bufs[i].dirty) {
+            pp_idx = i;
+            return;
+        }
+    E.mode = MODE_NORMAL;
+    g_quit = 1;
+}
+
+static void prompt_key(int key) {
+    switch (key) {
+    case 'y':
+    case 'Y':
+        if (pp_idx == E.bl->cur) cmd_save();
+        else save_buffer(&E.bl->bufs[pp_idx]);
+        buf_sync();
+        prompt_next();
+        break;
+    case 'n':
+    case 'N':
+        prompt_next();
+        break;
+    case ESC:
+    case CTRL('C'):
+    case CTRL('G'):
+    case CTRL('Q'):
+        E.mode = MODE_NORMAL;
+        break;
+    default:
+        break;
+    }
+}
+
