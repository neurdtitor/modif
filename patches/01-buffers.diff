+/* --------------------------- buffer list management ------------------------ */
+
+/* One active buffer lives in E.buf, the full set in E.blist[]. While a buffer
+ * is active it is edited through E.buf; buf_sync() pushes it (plus view state)
+ * back into its slot before switching, buf_load() pulls another slot in. */
+static void buf_sync(void) {
+    if (!E.nb) return;
+    E.blist[E.cb] = E.buf;
+    E.blist[E.cb].cur = E.cur;
+    E.blist[E.cb].top = E.top;
+    E.blist[E.cb].left = E.left;
+    E.blist[E.cb].mark = E.mark;
+    E.blist[E.cb].dirty = E.dirty;
+}
+
+static void buf_load(size_t i) {
+    E.cb = i;
+    E.buf = E.blist[i];
+    E.cur = E.buf.cur;
+    E.top = E.buf.top;
+    E.left = E.buf.left;
+    E.mark = E.buf.mark;
+    E.dirty = E.buf.dirty;
+}
+
+static void buf_add(Buffer *nb) {
+    buf_sync();
+    if (E.nb == E.bcap) {
+        E.bcap = E.bcap ? E.bcap * 2 : 4;
+        E.blist = realloc(E.blist, E.bcap * sizeof(Buffer));
+    }
+    E.blist[E.nb] = *nb;
+    E.nb++;
+    buf_load(E.nb - 1);
+}
+
+static void buf_switch(int dir) {
+    if (E.nb < 2) return;
+    buf_sync();
+    buf_load((size_t)(((long)E.cb + dir + (long)E.nb) % (long)E.nb));
+}
+
+static void buf_new(void) {
+    Buffer nb;
+    buf_init(&nb);
+    buf_build_lines(&nb);
+    buf_add(&nb);
+}
+
+static void buf_close(int force) {
+    if (E.dirty && !force) {
+        edit_set_status("no write since last change (use :bd! / :q!)");
+        return;
+    }
+    if (E.nb == 1) {
+        buf_sync();
+        buf_free(&E.blist[E.cb]);
+        E.nb = 0;
+        g_quit = 1;
+        return;
+    }
+    buf_sync();
+    buf_free(&E.blist[E.cb]);
+    memmove(&E.blist[E.cb], &E.blist[E.cb + 1],
+            (E.nb - E.cb - 1) * sizeof(Buffer));
+    E.nb--;
+    if (E.cb >= E.nb) E.cb = E.nb - 1;
+    buf_load(E.cb);
+}
+
+static void buf_list(void) {
+    buf_sync();
+    char tmp[160];
+    size_t off = 0;
+    off += (size_t)snprintf(tmp + off, sizeof tmp - off, "%zu buffer(s):", E.nb);
+    for (size_t i = 0; i < E.nb && off < sizeof tmp; i++) {
+        const char *n = E.blist[i].name ? E.blist[i].name : "[no name]";
+        off += (size_t)snprintf(tmp + off, sizeof tmp - off, " %zu%s%s%s",
+                                i + 1, i == E.cb ? "%" : "", n,
+                                E.blist[i].dirty ? "*" : "");
+    }
+    edit_set_status("%s", tmp);
+}
