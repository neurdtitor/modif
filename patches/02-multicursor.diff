index 0000000..ce07c03
--- /dev/null
+++ b/mc.h
@@ -0,0 +1,46 @@
+#ifndef MODIF_MC_H
+#define MODIF_MC_H
+
+#include <stddef.h>
+
+/* Multi-cursor state, owned entirely by mc.c. Editor holds an MCState* so no
+ * other file needs to know its internals. */
+typedef struct {
+    size_t *cur;    /* one buffer position per cursor */
+    size_t n;       /* number of cursors */
+    size_t cap;     /* allocated capacity of cur[] */
+    int active;     /* 1 while multi-cursor editing is on */
+    size_t primary; /* index of the primary cursor */
+    char word[64];  /* word remembered when enabling, for <space>c/C */
+    size_t wlen;
+} MCState;
+
+/* Allocate and initialise E.mc. Call once at startup. */
+void mc_init(void);
+
+/* 1 while multi-cursor editing is on. */
+int mc_active(void);
+
+/* Editing hooks called from edit.c: apply one edit at every cursor. */
+void mc_insert(const char *s, size_t n);
+void mc_backspace(void);
+void mc_delchar(void);
+void mc_append(void);
+void mc_bol(void);
+void mc_eol(void);
+
+/* Move every cursor with a motion (run fn count times per cursor). */
+void mc_sweep(void (*fn)(void), size_t count);
