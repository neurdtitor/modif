diff --git a/mc.c b/mc.c
new file mode 100644
index 0000000..cd7e627
--- /dev/null
+++ b/mc.c
@@ -0,0 +1,231 @@
+#include <ctype.h>
+#include <stdlib.h>
+#include <string.h>
+#include "edit.h"
+#include "mc.h"
+
+/* ----------------------------- multiple cursors ---------------------------- */
+
+/* <space>c enables multi-cursor mode with a cursor at the current position
+ * (the word under it is remembered); pressing it again adds the next
+ * occurrence of that word, <space>C adds every occurrence at once, and
+ * <space>x / Esc leaves. While active, motions move all cursors and edits
+ * apply at every cursor. Undo records each cursor's edit separately, so `u`
+ * removes them one at a time. */
+
+extern Editor E;
+
+/* Raw insert/delete primitives, exported by edit.c so mc.c applies each
+ * cursor's edit through the same undo-log path as normal editing. */
+void ed_apply_insert(size_t pos, const char *s, size_t n);
+void ed_apply_delete(size_t pos, const char *s, size_t n);
+
+void mc_init(void) {
+    E.mc = calloc(1, sizeof(MCState));
+}
+
+int mc_active(void) { return E.mc && E.mc->active; }
+
+static void mc_exit(void) {
+    free(E.mc->cur);
+    E.mc->cur = NULL;
+    E.mc->n = E.mc->cap = 0;
+    E.mc->active = 0;
+    E.mc->primary = 0;
+    E.mc->wlen = 0;
+}
+
+/* Sort mc_order[] so cursors are visited in descending buffer position, which
+ * keeps earlier positions valid while inserting/deleting. */
+static size_t *mc_order;
+static size_t mc_order_cap;
+
+static void mc_order_by_pos(void) {
+    if (mc_order_cap < E.mc->n) {
+        mc_order_cap = E.mc->n;
+        mc_order = realloc(mc_order, mc_order_cap * sizeof(size_t));
+    }
+    for (size_t i = 0; i < E.mc->n; i++) mc_order[i] = i;
+    for (size_t i = 1; i < E.mc->n; i++) {
+        size_t v = mc_order[i], j = i;
+        while (j > 0 && E.mc->cur[mc_order[j - 1]] < E.mc->cur[v]) {
+            mc_order[j] = mc_order[j - 1];
+            j--;
+        }
+        mc_order[j] = v;
+    }
+}
+
+void mc_insert(const char *s, size_t n) {
+    if (!n || !E.mc) return;
+    mc_order_by_pos();
+    for (size_t i = 0; i < E.mc->n; i++) {
+        size_t k = mc_order[i];
+        size_t p = E.mc->cur[k];
+        ed_apply_insert(p, s, n);
+        E.mc->cur[k] = p + n;
+        /* edits below a cursor shift it forward; edits above leave it alone */
+        for (size_t j = 0; j < E.mc->n; j++)
+            if (j != k && E.mc->cur[j] > p) E.mc->cur[j] += n;
+    }
+    E.cur = E.mc->cur[E.mc->primary];
+    E.dirty = 1;
+}
+
+/* Delete [p - before, p - before + n) at each cursor. */
+void mc_delete_impl(size_t before, size_t n) {
+    if (!E.mc) return;
+    mc_order_by_pos();
+    size_t blen = gb_len(&E.buf.gb);
+    for (size_t i = 0; i < E.mc->n; i++) {
+        size_t k = mc_order[i];
+        size_t p = E.mc->cur[k];
+        if (p < before) continue;
+        size_t s = p - before;
+        if (s >= blen) continue;
+        size_t e = s + n;
+        if (e > blen) e = blen;
+        if (e <= s) continue;
+        char *sl = gb_slice(&E.buf.gb, s, e - s);
+        ed_apply_delete(s, sl, e - s);
+        free(sl);
+        E.mc->cur[k] = s;
+        for (size_t j = 0; j < E.mc->n; j++) {
+            if (j == k) continue;
+            if (E.mc->cur[j] >= e) E.mc->cur[j] -= (e - s);
+            else if (E.mc->cur[j] > s) E.mc->cur[j] = s;
+        }
+    }
+    E.cur = E.mc->cur[E.mc->primary];
+    E.dirty = 1;
+}
+
+void mc_backspace(void) { mc_delete_impl(1, 1); }
+void mc_delchar(void) { mc_delete_impl(0, 1); }
+
+void mc_append(void) {
+    for (size_t i = 0; i < E.mc->n; i++) {
+        size_t p = E.mc->cur[i];
+        size_t li = buf_line_of(&E.buf, p);
+        if (p < E.buf.lines[li].start + E.buf.lines[li].len) E.mc->cur[i]++;
+    }
+    E.cur = E.mc->cur[E.mc->primary];
+}
+
+void mc_bol(void) {
+    for (size_t i = 0; i < E.mc->n; i++) {
+        size_t li = buf_line_of(&E.buf, E.mc->cur[i]);
+        E.mc->cur[i] = E.buf.lines[li].start;
+    }
+    E.cur = E.mc->cur[E.mc->primary];
+}
+
+void mc_eol(void) {
+    for (size_t i = 0; i < E.mc->n; i++) {
+        size_t li = buf_line_of(&E.buf, E.mc->cur[i]);
+        E.mc->cur[i] = E.buf.lines[li].start + E.buf.lines[li].len;
+    }
+    E.cur = E.mc->cur[E.mc->primary];
+}
+
+void mc_sweep(void (*fn)(void), size_t count) {
+    for (size_t i = 0; i < E.mc->n; i++) {
+        E.cur = E.mc->cur[i];
+        for (size_t j = 0; j < count; j++) fn();
+        E.mc->cur[i] = E.cur;
+    }
+    E.cur = E.mc->cur[E.mc->primary];
+}
+
+void mc_clamp(size_t len) {
+    if (!E.mc) return;
+    for (size_t i = 0; i < E.mc->n; i++)
+        if (E.mc->cur[i] > len) E.mc->cur[i] = len;
+}
+
+size_t mc_count(void) { return E.mc ? E.mc->n : 0; }
+
+/* Copy the word at the primary cursor into E.mc->word. */
+static void mc_grab_word(void) {
+    size_t len = gb_len(&E.buf.gb);
+    size_t i = E.cur, s;
+    while (i < len) {
+        char c = gb_at(&E.buf.gb, i);
+        if (isalnum((unsigned char)c) || c == '_') break;
+        i++;
+    }
+    s = i;
+    while (i < len) {
+        char c = gb_at(&E.buf.gb, i);
+        if (!isalnum((unsigned char)c) && c != '_') break;
+        i++;
+    }
+    E.mc->wlen = i - s;
+    if (E.mc->wlen > sizeof E.mc->word - 1) E.mc->wlen = sizeof E.mc->word - 1;
+    for (size_t j = 0; j < E.mc->wlen; j++) E.mc->word[j] = gb_at(&E.buf.gb, s + j);
+    E.mc->word[E.mc->wlen] = '\0';
+}
+
+static void mc_enable(void) {
+    E.mc->cur = malloc(sizeof(size_t));
+    E.mc->cur[0] = E.cur;
+    E.mc->n = 1;
+    E.mc->cap = 1;
+    E.mc->active = 1;
+    E.mc->primary = 0;
+    mc_grab_word();
+    edit_set_status("multi-cursor: 1  (<space>c = add next, <space>C = all, <space>x = done)");
+}
+
+/* Add a cursor if it is not already present; makes it the primary. */
+static int mc_add(size_t pos) {
+    for (size_t i = 0; i < E.mc->n; i++)
+        if (E.mc->cur[i] == pos) return 0;
+    if (E.mc->n == E.mc->cap) {
+        E.mc->cap = E.mc->cap ? E.mc->cap * 2 : 8;
+        E.mc->cur = realloc(E.mc->cur, E.mc->cap * sizeof(size_t));
+    }
+    E.mc->cur[E.mc->n++] = pos;
+    E.mc->primary = E.mc->n - 1;
+    E.cur = pos;
+    return 1;
+}
+
+void cmd_mc_add_next(void) {
+    if (!E.mc) return;
+    if (!E.mc->active) { mc_enable(); return; }
+    if (!E.mc->wlen) { edit_set_status("no word under cursor"); return; }
+    size_t maxpos = 0;
+    for (size_t i = 0; i < E.mc->n; i++)
+        if (E.mc->cur[i] > maxpos) maxpos = E.mc->cur[i];
+    size_t len = gb_len(&E.buf.gb);
+    size_t hit = (size_t)-1;
+    if (maxpos + E.mc->wlen <= len)
+        hit = gb_find(&E.buf.gb, E.mc->word, E.mc->wlen, maxpos + E.mc->wlen);
+    if (hit == (size_t)-1)
+        hit = gb_find(&E.buf.gb, E.mc->word, E.mc->wlen, 0);
+    if (hit == (size_t)-1) { edit_set_status("no more matches"); return; }
+    mc_add(hit);
+    edit_set_status("multi-cursor: %zu  (<space>c = add next, <space>C = all, <space>x = done)", E.mc->n);
+}
+
+void cmd_mc_add_all(void) {
+    if (!E.mc) return;
+    if (!E.mc->active) mc_enable();
+    if (!E.mc->wlen) { edit_set_status("no word under cursor"); return; }
+    size_t len = gb_len(&E.buf.gb);
+    size_t from = 0, added = 0;
+    while (from <= len) {
+        size_t hit = gb_find(&E.buf.gb, E.mc->word, E.mc->wlen, from);
+        if (hit == (size_t)-1) break;
+        if (mc_add(hit)) added++;
+        from = hit + E.mc->wlen;
+    }
+    edit_set_status("multi-cursor: %zu cursor(s) (%zu added)", E.mc->n, added);
+}
+
+void cmd_mc_exit(void) {
+    if (!E.mc || !E.mc->active) return;
+    mc_exit();
+    edit_set_status("multi-cursor off");
+}
