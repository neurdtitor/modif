     E.cmdq[0] = '\0';
 }
 
+/* ------------------------- quit all + save prompts ------------------------ */
+
+static size_t pp_idx; /* buffer index being prompted, SIZE_MAX = none */
+
+static void save_all(void) {
+    buf_sync();
+    for (size_t i = 0; i < E.nb; i++)
+        if (E.blist[i].dirty) {
+            if (i == E.cb) cmd_save();
+            else save_buffer(&E.blist[i]);
+        }
+    buf_sync();
+}
+
+/* Quit every buffer. Unless force, ask about each unsaved buffer first. */
+static void quit_all(int force) {
+    buf_sync();
+    if (!force)
+        for (size_t i = 0; i < E.nb; i++)
+            if (E.blist[i].dirty) {
+                pp_idx = i;
+                E.mode = MODE_PROMPT;
+                return;
+            }
+    g_quit = 1;
+}
+
+static void prompt_next(void) {
+    for (size_t i = pp_idx + 1; i < E.nb; i++)
+        if (E.blist[i].dirty) {
+            pp_idx = i;
+            return;
+        }
+    E.mode = MODE_NORMAL;
+    g_quit = 1;
+}
+
+static void prompt_key(int key) {
+    switch (key) {
+    case 'y':
+    case 'Y':
+        if (pp_idx == E.cb) cmd_save();
+        else save_buffer(&E.blist[pp_idx]);
+        buf_sync();
+        prompt_next();
+        break;
+    case 'n':
+    case 'N':
+        prompt_next();
+        break;
+    case ESC:
+    case CTRL('C'):
+    case CTRL('G'):
+    case CTRL('Q'):
+        E.mode = MODE_NORMAL;
+        break;
+    default:
+        break;
+    }
+}
