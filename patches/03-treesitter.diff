diff --git a/highlight.c b/highlight.c
new file mode 100644
index 0000000..5e9bcc1
--- /dev/null
+++ b/highlight.c
@@ -0,0 +1,452 @@
+#include <ctype.h>
+#include <dlfcn.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "highlight.h"
+#include "tree_sitter/api.h"
+
+/* Syntax highlighting through tree-sitter queries. Both the runtime library
+ * (libtree-sitter) and the per-language parser shared libraries are loaded at
+ * runtime with dlopen(), so the editor always builds and simply shows plain
+ * text when a parser is missing. Each language's colors come from a standard
+ * query file, queries/<lang>/highlights.scm — adding a language is just
+ * dropping in a parser library plus a query file, no C changes.
+ *
+ * All state lives in the HLState struct (highlight.h); the Editor only holds
+ * a pointer to it. The vendored tree_sitter/api.h pins the ABI of the runtime
+ * this was tested against (tree-sitter >= 0.21). */
+
+/* ----------------------- dynamically resolved runtime ---------------------- */
+
+typedef struct {
+    void *dl;
+    TSParser *(*parser_new)(void);
+    void (*parser_delete)(TSParser *);
+    bool (*parser_set_language)(TSParser *, const TSLanguage *);
+    TSTree *(*parser_parse_string)(TSParser *, const TSTree *, const char *, uint32_t);
+    void (*tree_delete)(TSTree *);
+    TSNode (*tree_root_node)(const TSTree *);
+    uint32_t (*node_start_byte)(TSNode);
+    uint32_t (*node_end_byte)(TSNode);
+    TSQuery *(*query_new)(const TSLanguage *, const char *, uint32_t,
+                          uint32_t *, TSQueryError *);
+    void (*query_delete)(TSQuery *);
+    const char *(*query_capture_name_for_id)(const TSQuery *, uint32_t, uint32_t *);
+    TSQueryCursor *(*query_cursor_new)(void);
+    void (*query_cursor_delete)(TSQueryCursor *);
+    void (*query_cursor_exec)(TSQueryCursor *, const TSQuery *, TSNode);
+    bool (*query_cursor_next_capture)(TSQueryCursor *, TSQueryMatch *, uint32_t *);
+} TSRt;
+
+typedef struct {
+    const char *name;
+    const char *libs[5];
+    const char *exts[7];
+    void *dl;
+    const TSLanguage *(*get)(void);
+    TSQuery *query; /* compiled from queries/<name>/highlights.scm */
+} HLLang;
+
+struct HLState {
+    TSRt rt;
+    int rt_ok;
+    HLLang *langs;
+    size_t nlang;
+    size_t lang_loaded;
+    TSParser *parser;
+    TSTree *tree;
+    TSQueryCursor *cursor;
+    uint8_t *classes;
+    size_t classes_len, classes_cap;
+    int s_dirty;
+    HLLang *active;
+};
+
+static HLLang lang_tab[] = {
+    { "rust",
+      { "librust-tree-sitter.dylib", "libtree-sitter-rust.dylib",
+        "librust-tree-sitter.so", "libtree-sitter-rust.so", NULL },
+      { "rs", NULL }, NULL, NULL, NULL },
+    { "python",
+      { "libpython-tree-sitter.dylib", "libtree-sitter-python.dylib",
+        "libpython-tree-sitter.so", "libtree-sitter-python.so", NULL },
+      { "py", "pyi", NULL }, NULL, NULL, NULL },
+    { "c",
+      { "libc-tree-sitter.dylib", "libtree-sitter-c.dylib",
+        "libc-tree-sitter.so", "libtree-sitter-c.so", NULL },
+      { "c", "h", NULL }, NULL, NULL, NULL },
+    { "cpp",
+      { "libcpp-tree-sitter.dylib", "libtree-sitter-cpp.dylib",
+        "libcpp-tree-sitter.so", "libtree-sitter-cpp.so", NULL },
+      { "cc", "cpp", "cxx", "hpp", "hh", "hxx", NULL }, NULL, NULL, NULL },
+    { "javascript",
+      { "libjavascript-tree-sitter.dylib", "libtree-sitter-javascript.dylib",
+        "libjavascript-tree-sitter.so", "libtree-sitter-javascript.so", NULL },
+      { "js", "mjs", "cjs", "jsx", NULL }, NULL, NULL, NULL },
+    { "java",
+      { "libjava-tree-sitter.dylib", "libtree-sitter-java.dylib",
+        "libjava-tree-sitter.so", "libtree-sitter-java.so", NULL },
+      { "java", NULL }, NULL, NULL, NULL },
+};
+
+/* Try to open a shared library, first by plain name (loader search path),
+ * then in the usual homebrew/user install dirs. */
+static void *try_dlopen(const char *base) {
+    void *dl = dlopen(base, RTLD_NOW | RTLD_LOCAL);
+    if (dl) return dl;
+    char path[1024];
+    const char *dirs[] = { "/opt/homebrew/lib", "/usr/local/lib", NULL };
+    for (size_t i = 0; dirs[i]; i++) {
+        snprintf(path, sizeof path, "%s/%s", dirs[i], base);
+        dl = dlopen(path, RTLD_NOW | RTLD_LOCAL);
+        if (dl) return dl;
+    }
+    const char *home = getenv("HOME");
+    if (home) {
+        snprintf(path, sizeof path, "%s/.local/lib/%s", home, base);
+        dl = dlopen(path, RTLD_NOW | RTLD_LOCAL);
+        if (dl) return dl;
+    }
+    return NULL;
+}
+
+static void *dlsym_checked(void *dl, const char *sym) {
+    dlerror();
+    void *p = dlsym(dl, sym);
+    return dlerror() ? NULL : p;
+}
+
+#define LOAD(field, sym) do { *(void **)(&rt.field) = dlsym_checked(rt.dl, sym); \
+    if (!rt.field) return; } while (0)
+
+static void rt_load(HLState *h) {
+    TSRt rt = h->rt;
+    rt.dl = try_dlopen("libtree-sitter.dylib");
+    if (!rt.dl) rt.dl = try_dlopen("libtree-sitter.so");
+    if (!rt.dl) return;
+    LOAD(parser_new, "ts_parser_new");
+    LOAD(parser_delete, "ts_parser_delete");
+    LOAD(parser_set_language, "ts_parser_set_language");
+    LOAD(parser_parse_string, "ts_parser_parse_string");
+    LOAD(tree_delete, "ts_tree_delete");
+    LOAD(tree_root_node, "ts_tree_root_node");
+    LOAD(node_start_byte, "ts_node_start_byte");
+    LOAD(node_end_byte, "ts_node_end_byte");
+    LOAD(query_new, "ts_query_new");
+    LOAD(query_delete, "ts_query_delete");
+    LOAD(query_capture_name_for_id, "ts_query_capture_name_for_id");
+    LOAD(query_cursor_new, "ts_query_cursor_new");
+    LOAD(query_cursor_delete, "ts_query_cursor_delete");
+    LOAD(query_cursor_exec, "ts_query_cursor_exec");
+    LOAD(query_cursor_next_capture, "ts_query_cursor_next_capture");
+    h->rt = rt;
+    h->rt_ok = 1;
+}
+
+/* ------------------------------ language table ----------------------------- */
+
+static HLLang *lang_for_ext(HLState *h, const char *name) {
+    if (!name) return NULL;
+    const char *dot = strrchr(name, '.');
+    if (!dot || !dot[1]) return NULL;
+    for (size_t i = 0; i < h->nlang; i++) {
+        if (!h->langs[i].get) continue;
+        for (size_t j = 0; h->langs[i].exts[j]; j++)
+            if (!strcmp(dot + 1, h->langs[i].exts[j])) return &h->langs[i];
+    }
+    return NULL;
+}
+
+/* The language a filename maps to, whether or not its parser is loaded. */
+static HLLang *lang_known(HLState *h, const char *name) {
+    if (!name) return NULL;
+    const char *dot = strrchr(name, '.');
+    if (!dot || !dot[1]) return NULL;
+    for (size_t i = 0; i < h->nlang; i++) {
+        for (size_t j = 0; h->langs[i].exts[j]; j++)
+            if (!strcmp(dot + 1, h->langs[i].exts[j])) return &h->langs[i];
+    }
+    return NULL;
+}
+
+/* ------------------------- query file loading ------------------------------ */
+
+/* Read queries/<lang>/highlights.scm, honouring the MODIF_QUERY_DIR
+ * environment variable as the queries directory (default: "queries" in the
+ * current directory). Returns malloc'd NUL-terminated source, or NULL. */
+static char *query_read(const char *lang) {
+    const char *dir = getenv("MODIF_QUERY_DIR");
+    if (!dir || !*dir) dir = "queries";
+    char path[1024];
+    snprintf(path, sizeof path, "%s/%s/highlights.scm", dir, lang);
+    FILE *f = fopen(path, "rb");
+    if (!f) return NULL;
+    fseek(f, 0, SEEK_END);
+    long n = ftell(f);
+    fseek(f, 0, SEEK_SET);
+    if (n < 0) { fclose(f); return NULL; }
+    char *src = malloc((size_t)n + 1);
+    if (src && n > 0 && fread(src, 1, (size_t)n, f) != (size_t)n) {
+        free(src);
+        src = NULL;
+    }
+    fclose(f);
+    if (src) src[n] = '\0';
+    return src;
+}
+
+/* Compile a language's highlights.scm into a TSQuery, or NULL if there is no
+ * query file or it fails to parse. */
+static TSQuery *query_compile(HLState *h, HLLang *l) {
+    char *src = query_read(l->name);
+    if (!src) return NULL;
+    uint32_t err_off = 0;
+    TSQueryError err = TSQueryErrorNone;
+    TSQuery *q = h->rt.query_new(l->get(), src, (uint32_t)strlen(src),
+                                 &err_off, &err);
+    if (!q)
+        fprintf(stderr, "modif: query error in %s/highlights.scm at byte %u\n",
+                l->name, err_off);
+    free(src);
+    return q;
+}
+
+/* ------------------------- capture name -> category ------------------------ */
+
+/* Map a query capture name (without the leading @) to a highlight category.
+ * Matches the dotted name first, then its base segment, so @keyword.function
+ * and @keyword both land on HL_KEYWORD while @variable.member can be given a
+ * distinct category. Unknown captures are HL_NONE (no color). */
+static int capture_class(const char *name) {
+    static const struct { const char *cap; int cat; } map[] = {
+        { "variable.member", HL_FIELD },
+        { "variable.parameter", HL_PARAM },
+        { "keyword", HL_KEYWORD },
+        { "keyword.function", HL_KEYWORD },
+        { "keyword.operator", HL_KEYWORD },
+        { "keyword.return", HL_KEYWORD },
+        { "keyword.type", HL_KEYWORD },
+        { "type", HL_TYPE },
+        { "type.builtin", HL_TYPE },
+        { "type.definition", HL_TYPE },
+        { "string", HL_STRING },
+        { "string.escape", HL_STRING },
+        { "string.special", HL_STRING },
+        { "string.regexp", HL_STRING },
+        { "character", HL_STRING },
+        { "character.special", HL_STRING },
+        { "comment", HL_COMMENT },
+        { "comment.documentation", HL_COMMENT },
+        { "number", HL_NUMBER },
+        { "number.float", HL_NUMBER },
+        { "float", HL_NUMBER },
+        { "function", HL_FUNC },
+        { "function.call", HL_FUNC },
+        { "function.builtin", HL_FUNC },
+        { "function.macro", HL_FUNC },
+        { "method", HL_FUNC },
+        { "method.call", HL_FUNC },
+        { "constant", HL_CONST },
+        { "constant.builtin", HL_CONST },
+        { "constant.macro", HL_CONST },
+        { "boolean", HL_CONST },
+        { "nil", HL_CONST },
+        { "preproc", HL_PREPROC },
+        { "preproc.include", HL_PREPROC },
+        { "include", HL_PREPROC },
+        { "define", HL_PREPROC },
+        { "conditional", HL_PREPROC },
+        { "directive", HL_PREPROC },
+        { "operator", HL_OP },
+        { "field", HL_FIELD },
+        { "property", HL_FIELD },
+        { "namespace", HL_NAMESPACE },
+        { "module", HL_NAMESPACE },
+        { "parameter", HL_PARAM },
+        { "label", HL_LABEL },
+        { "macro", HL_MACRO },
+        { "punctuation", HL_PUNCT },
+        { "punctuation.bracket", HL_PUNCT },
+        { "punctuation.delimiter", HL_PUNCT },
+        { "punctuation.special", HL_PUNCT },
+        { "punct", HL_PUNCT },
+        { "tag", HL_SPECIAL },
+        { "tag.attribute", HL_SPECIAL },
+        { "tag.delimiter", HL_SPECIAL },
+        { "attribute", HL_PREPROC },
+        { NULL, HL_NONE },
+    };
+    if (!name) return HL_NONE;
+    for (size_t i = 0; map[i].cap; i++)
+        if (!strcmp(name, map[i].cap)) return map[i].cat;
+    char base[64];
+    size_t n = strcspn(name, ".");
+    if (n >= sizeof base) n = sizeof base - 1;
+    memcpy(base, name, n);
+    base[n] = '\0';
+    for (size_t i = 0; map[i].cap; i++)
+        if (!strcmp(base, map[i].cap)) return map[i].cat;
+    return HL_NONE;
+}
+
+/* Run the active language's query over the parse tree, filling classes[] with
+ * a category per byte. */
+static void hl_run_query(HLState *h, TSNode root) {
+    if (!h->active || !h->active->query) return;
+    if (!h->cursor) h->cursor = h->rt.query_cursor_new();
+    h->rt.query_cursor_exec(h->cursor, h->active->query, root);
+    TSQueryMatch match;
+    uint32_t cap_idx;
+    while (h->rt.query_cursor_next_capture(h->cursor, &match, &cap_idx)) {
+        if (cap_idx >= match.capture_count) continue;
+        TSQueryCapture cap = match.captures[cap_idx];
+        uint32_t nlen = 0;
+        const char *cname = h->rt.query_capture_name_for_id(
+            h->active->query, cap.index, &nlen);
+        int cat = capture_class(cname);
+        if (cat == HL_NONE) continue;
+        uint32_t s = h->rt.node_start_byte(cap.node);
+        uint32_t e = h->rt.node_end_byte(cap.node);
+        if (e <= s || s >= h->classes_len) continue;
+        size_t nbytes = e - s;
+        if (s + nbytes > h->classes_len) nbytes = h->classes_len - s;
+        memset(h->classes + s, cat, nbytes);
+    }
+}
+
+/* -------------------------------- palette ---------------------------------- */
+
+int hl_color(int cat) {
+    static const int pal[HL_COUNT] = {
+        -1,        /* HL_NONE */
+        204,       /* HL_KEYWORD red */
+        81,        /* HL_TYPE light blue */
+        77,        /* HL_STRING green */
+        246,       /* HL_COMMENT gray */
+        180,       /* HL_NUMBER tan */
+        221,       /* HL_FUNC yellow */
+        208,       /* HL_PREPROC orange */
+        250,       /* HL_OP light gray */
+        141,       /* HL_CONST purple */
+        75,        /* HL_FIELD blue */
+        81,        /* HL_NAMESPACE light blue */
+        152,       /* HL_PARAM gray blue */
+        209,       /* HL_LABEL orange red */
+        172,       /* HL_MACRO orange */
+        250,       /* HL_PUNCT light gray */
+        203,       /* HL_SPECIAL red */
+    };
+    if (cat <= 0 || cat >= HL_COUNT) return -1;
+    return pal[cat];
+}
+
+/* -------------------------------- public API ------------------------------- */
+
+HLState *hl_init(void) {
+    HLState *h = calloc(1, sizeof *h);
+    if (!h) return NULL;
+    rt_load(h);
+    if (!h->rt_ok) return h;
+    h->parser = h->rt.parser_new();
+    if (!h->parser) return h;
+    h->langs = lang_tab;
+    h->nlang = sizeof lang_tab / sizeof lang_tab[0];
+    char sym[128];
+    for (size_t i = 0; i < h->nlang; i++) {
+        for (size_t j = 0; h->langs[i].libs[j]; j++) {
+            void *dl = try_dlopen(h->langs[i].libs[j]);
+            if (!dl) continue;
+            snprintf(sym, sizeof sym, "tree_sitter_%s", h->langs[i].name);
+            h->langs[i].get = (const TSLanguage *(*)(void))dlsym_checked(dl, sym);
+            if (h->langs[i].get) {
+                h->langs[i].dl = dl;
+                h->lang_loaded++;
+                h->langs[i].query = query_compile(h, &h->langs[i]);
+                break;
+            }
+            dlclose(dl);
+        }
+    }
+    return h;
+}
+
+void hl_free(HLState *h) {
+    if (!h) return;
+    if (h->rt_ok) {
+        for (size_t i = 0; i < h->nlang; i++) {
+            if (h->langs[i].query) h->rt.query_delete(h->langs[i].query);
+            if (h->langs[i].dl) dlclose(h->langs[i].dl);
+        }
+        if (h->tree) h->rt.tree_delete(h->tree);
+        if (h->cursor) h->rt.query_cursor_delete(h->cursor);
+        h->rt.parser_delete(h->parser);
+    }
+    free(h->classes);
+    free(h);
+}
+
+int hl_runtime_ok(HLState *h) { return h && h->rt_ok; }
+int hl_lang_count(HLState *h) { return h ? (int)h->lang_loaded : 0; }
+int hl_active(HLState *h) { return h && h->rt_ok && h->active && h->active->query; }
+
+/* If highlighting can't run for a file of this name, return a short, static
+ * message saying what to install; otherwise NULL. */
+const char *hl_hint(HLState *h, const char *name) {
+    if (!h || !h->rt_ok) return "tree-sitter runtime not found; install libtree-sitter";
+    HLLang *k = lang_known(h, name);
+    if (!k) return NULL;             /* no parser for this file type */
+    if (k->get && k->query) return NULL; /* everything available */
+    if (!k->get) {
+        static char msg[128];
+        snprintf(msg, sizeof msg,
+                 "syntax: no tree-sitter parser for %s; install lib%s-tree-sitter",
+                 k->name, k->name);
+        return msg;
+    }
+    return "syntax: missing queries/<lang>/highlights.scm for this file";
+}
+
+void hl_dirty(HLState *h) {
+    if (h) h->s_dirty = 1;
+}
+
+const uint8_t *hl_classes(HLState *h, size_t *len) {
+    if (len) *len = h ? h->classes_len : 0;
+    return h ? h->classes : NULL;
+}
+
+void hl_update(HLState *h, Buffer *buf) {
+    if (!h || !h->s_dirty) return;
+    h->s_dirty = 0;
+    if (!h->rt_ok || !h->parser) return;
+    HLLang *l = lang_for_ext(h, buf->name);
+    if (l != h->active) {
+        h->active = l;
+        if (!l || !h->rt.parser_set_language(h->parser, l->get())) {
+            h->active = NULL;
+            if (h->tree) { h->rt.tree_delete(h->tree); h->tree = NULL; }
+            return;
+        }
+    }
+    if (!h->active || !h->active->query) return;
+
+    size_t len = gb_len(&buf->gb);
+    if (len > 0x7fffffffu) return; /* tree-sitter takes uint32 lengths */
+    char *src = gb_slice(&buf->gb, 0, len);
+    if (h->tree) { h->rt.tree_delete(h->tree); h->tree = NULL; }
+    h->tree = h->rt.parser_parse_string(h->parser, NULL, src, (uint32_t)len);
+    free(src);
+    if (!h->tree) return;
+
+    if (h->classes_cap < len) {
+        h->classes_cap = len ? len : 1;
+        h->classes = realloc(h->classes, h->classes_cap);
+    }
+    h->classes_len = len;
+    if (len) {
+        memset(h->classes, 0, len);
+        hl_run_query(h, h->rt.tree_root_node(h->tree));
+    }
+}
