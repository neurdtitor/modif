+#ifndef MODIF_HIGHLIGHT_H
+#define MODIF_HIGHLIGHT_H
+
+#include <stddef.h>
+#include "buffer.h"
+
+/* Syntax-highlight categories (indices into a shared color palette). */
+enum {
+    HL_NONE = 0,
+    HL_KEYWORD, HL_TYPE, HL_STRING, HL_COMMENT, HL_NUMBER, HL_FUNC,
+    HL_PREPROC, HL_OP, HL_CONST, HL_FIELD, HL_NAMESPACE, HL_PARAM,
+    HL_LABEL, HL_MACRO, HL_PUNCT, HL_SPECIAL,
+    HL_COUNT
+};
+
+/* Opaque. highlight.c owns every byte of it; the Editor just holds a
+ * pointer, and main.c / edit.c only call the functions below. */
+typedef struct HLState HLState;
+
+/* 256-color index for a category, or -1 to use the terminal default. */
+int hl_color(int cat);
+
+/* Load the tree-sitter runtime, the per-language parsers and their
+ * queries/<lang>/highlights.scm query files. Call once at startup. */
+HLState *hl_init(void);
+void hl_free(HLState *h);
+int hl_runtime_ok(HLState *h);
+int hl_lang_count(HLState *h);
+int hl_active(HLState *h);
+
+/* If highlighting can't run for a file of this name (missing runtime, parser
+ * or query file), returns a short static message; else NULL. */
+const char *hl_hint(HLState *h, const char *name);
+
+/* Mark the highlighted text as stale; hl_update() re-parses lazily. */
+void hl_dirty(HLState *h);
+
+/* Re-parse buf (if stale and a matching language parser is available) and
+ * rebuild the per-byte color class table from the language's highlights.scm.
+ * Safe to call every frame. */
+void hl_update(HLState *h, Buffer *buf);
+
+/* Byte-indexed color-class table from the last hl_update(), and its length. */
+const uint8_t *hl_classes(HLState *h, size_t *len);
+
+#endif
