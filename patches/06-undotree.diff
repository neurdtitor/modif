+/* Replay undo/redo from the current state to a target leaf. */
+static void undo_jump(size_t target) {
+    Undo *u = &E.buf.undo;
+    if (target == u->cur) return;
+    size_t nc, nl;
+    size_t *pc = undo_path(u->cur, &nc);
+    size_t *pl = undo_path(target, &nl);
+    size_t common = 0; /* length of the shared root prefix */
+    while (common < nc && common < nl && pc[common] == pl[common]) common++;
+    size_t fork = pc[common - 1]; /* last shared ancestor */
+    while (u->cur != fork) { /* undo up to the fork point */
+        UNode *e = &u->nodes[u->cur];
+        if (e->type == 0) buf_delete(&E.buf, e->pos, e->len);
+        else buf_insert(&E.buf, e->pos, e->data, e->len);
+        u->cur = e->parent;
+    }
+    for (size_t i = common; i < nl; i++) { /* redo down the chosen branch */
+        UNode *e = &u->nodes[pl[i]];
+        if (e->type == 0) {
