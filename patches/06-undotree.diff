+/* Path from the tree root to a node, root first. */
+static size_t *undo_path(size_t node, size_t *len) {
+    Undo *u = &E.buf.undo;
+    size_t n = 0, t = node;
+    while (t != UNDO_NONE) { n++; t = u->nodes[t].parent; }
+    size_t *p = malloc((n ? n : 1) * sizeof(size_t));
+    t = node;
+    for (size_t i = n; i > 0; i--) { p[i - 1] = t; t = u->nodes[t].parent; }
+    *len = n;
+    return p;
