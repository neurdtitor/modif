diff --git a/highlight.h b/highlight.h
new file mode 100644
index 0000000..42d69b5
--- /dev/null
+++ b/highlight.h
@@ -0,0 +1,40 @@
+#ifndef MODIF_HIGHLIGHT_H
+#define MODIF_HIGHLIGHT_H
+
+#include <stddef.h>
+#include "buffer.h"
+
+/* Syntax-highlight categories (indices into a shared color palette). */
+enum {
+    HL_NONE = 0,
+    HL_KEYWORD, HL_TYPE, HL_STRING, HL_COMMENT, HL_NUMBER, HL_FUNC,
+    HL_PREPROC, HL_OP, HL_CONST, HL_FIELD, HL_NAMESPACE, HL_PARAM,
+    HL_LABEL, HL_MACRO, HL_PUNCT, HL_SPECIAL,
+    HL_COUNT
+};
+
+/* 256-color index for a category, or -1 to use the terminal default. */
+int hl_color(int cat);
+
+/* Load the tree-sitter runtime and language parsers (dlopen at runtime, so
+ * the editor builds fine without them). Call once at startup. */
+void hl_init(void);
+int hl_runtime_ok(void);
+int hl_lang_count(void);
+int hl_active(void);
+
+/* If highlighting can't run for a file of this name (missing runtime or a
+ * missing language parser), returns a short static message; else NULL. */
+const char *hl_hint(const char *name);
+
+/* Mark the highlighted text as stale; hl_update() re-parses lazily. */
+void hl_dirty(void);
+
+/* Re-parse buf (if stale and a matching language parser is available) and
+ * rebuild the per-byte color class table. Safe to call every frame. */
+void hl_update(Buffer *buf);
+
+/* Byte-indexed color-class table from the last hl_update(), and its length. */
+const uint8_t *hl_classes(size_t *len);
+
+#endif
