diff --git a/highlight.c b/highlight.c
new file mode 100644
index 0000000..aa5a684
--- /dev/null
+++ b/highlight.c
@@ -0,0 +1,399 @@
+#include <ctype.h>
+#include <dlfcn.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "highlight.h"
+#include "tree_sitter/api.h"
+
+/* Syntax highlighting through tree-sitter. Both the runtime library
+ * (libtree-sitter) and the per-language parser shared libraries are loaded
+ * at runtime with dlopen(), so the editor always builds and simply shows
+ * plain text when a parser is missing. To enable highlighting install the
+ * tree-sitter runtime and the parser libraries for the languages you use
+ * (see README). Each language parser must export `tree_sitter_<lang>`.
+ *
+ * The vendored tree_sitter/api.h pins the ABI of the runtime this was
+ * tested against (tree-sitter >= 0.21). */
+
+/* ----------------------- dynamically resolved runtime ---------------------- */
+
+typedef struct {
+    void *dl;
+    TSParser *(*parser_new)(void);
+    void (*parser_delete)(TSParser *);
+    bool (*parser_set_language)(TSParser *, const TSLanguage *);
+    TSTree *(*parser_parse_string)(TSParser *, const TSTree *, const char *, uint32_t);
+    void (*tree_delete)(TSTree *);
+    TSNode (*tree_root_node)(const TSTree *);
+    const char *(*node_type)(TSNode);
+    bool (*node_is_named)(TSNode);
+    uint32_t (*node_child_count)(TSNode);
+    TSNode (*node_child)(TSNode, uint32_t);
+    uint32_t (*node_start_byte)(TSNode);
+    uint32_t (*node_end_byte)(TSNode);
+    TSNode (*node_parent)(TSNode);
+} TSRt;
+
+typedef struct {
+    const char *name;
+    const char *libs[5];
+    const char *exts[7];
+    void *dl;
+    const TSLanguage *(*get)(void);
+} HLLang;
+
+static TSRt rt;
+static int rt_ok;
+static HLLang *langs;
+static size_t nlang, lang_loaded;
+
+static HLLang lang_tab[] = {
+    { "rust",
+      { "librust-tree-sitter.dylib", "libtree-sitter-rust.dylib",
+        "librust-tree-sitter.so", "libtree-sitter-rust.so", NULL },
+      { "rs", NULL }, NULL, NULL },
+    { "python",
+      { "libpython-tree-sitter.dylib", "libtree-sitter-python.dylib",
+        "libpython-tree-sitter.so", "libtree-sitter-python.so", NULL },
+      { "py", "pyi", NULL }, NULL, NULL },
+    { "c",
+      { "libc-tree-sitter.dylib", "libtree-sitter-c.dylib",
+        "libc-tree-sitter.so", "libtree-sitter-c.so", NULL },
+      { "c", "h", NULL }, NULL, NULL },
+    { "cpp",
+      { "libcpp-tree-sitter.dylib", "libtree-sitter-cpp.dylib",
+        "libcpp-tree-sitter.so", "libtree-sitter-cpp.so", NULL },
+      { "cc", "cpp", "cxx", "hpp", "hh", "hxx", NULL }, NULL, NULL },
+    { "javascript",
+      { "libjavascript-tree-sitter.dylib", "libtree-sitter-javascript.dylib",
+        "libjavascript-tree-sitter.so", "libtree-sitter-javascript.so", NULL },
+      { "js", "mjs", "cjs", "jsx", NULL }, NULL, NULL },
+    { "java",
+      { "libjava-tree-sitter.dylib", "libtree-sitter-java.dylib",
+        "libjava-tree-sitter.so", "libtree-sitter-java.so", NULL },
+      { "java", NULL }, NULL, NULL },
+};
+
+/* Try to open a shared library, first by plain name (loader search path),
+ * then in the usual homebrew/user install dirs. */
+static void *try_dlopen(const char *base) {
+    void *dl = dlopen(base, RTLD_NOW | RTLD_LOCAL);
+    if (dl) return dl;
+    char path[1024];
+    const char *dirs[] = { "/opt/homebrew/lib", "/usr/local/lib", NULL };
+    for (size_t i = 0; dirs[i]; i++) {
+        snprintf(path, sizeof path, "%s/%s", dirs[i], base);
+        dl = dlopen(path, RTLD_NOW | RTLD_LOCAL);
+        if (dl) return dl;
+    }
+    const char *home = getenv("HOME");
+    if (home) {
+        snprintf(path, sizeof path, "%s/.local/lib/%s", home, base);
+        dl = dlopen(path, RTLD_NOW | RTLD_LOCAL);
+        if (dl) return dl;
+    }
+    return NULL;
+}
+
+static void *dlsym_checked(void *dl, const char *sym) {
+    dlerror();
+    void *p = dlsym(dl, sym);
+    return dlerror() ? NULL : p;
+}
+
+#define LOAD(field, sym) do { *(void **)(&rt.field) = dlsym_checked(rt.dl, sym); \
+    if (!rt.field) return; } while (0)
+
+static void rt_load(void) {
+    rt.dl = try_dlopen("libtree-sitter.dylib");
+    if (!rt.dl) rt.dl = try_dlopen("libtree-sitter.so");
+    if (!rt.dl) return;
+    LOAD(parser_new, "ts_parser_new");
+    LOAD(parser_delete, "ts_parser_delete");
+    LOAD(parser_set_language, "ts_parser_set_language");
+    LOAD(parser_parse_string, "ts_parser_parse_string");
+    LOAD(tree_delete, "ts_tree_delete");
+    LOAD(tree_root_node, "ts_tree_root_node");
+    LOAD(node_type, "ts_node_type");
+    LOAD(node_is_named, "ts_node_is_named");
+    LOAD(node_child_count, "ts_node_child_count");
+    LOAD(node_child, "ts_node_child");
+    LOAD(node_start_byte, "ts_node_start_byte");
+    LOAD(node_end_byte, "ts_node_end_byte");
+    LOAD(node_parent, "ts_node_parent");
+    rt_ok = 1;
+}
+
+/* ------------------------------ language table ----------------------------- */
+
+static HLLang *lang_for_ext(const char *name) {
+    if (!name) return NULL;
+    const char *dot = strrchr(name, '.');
+    if (!dot || !dot[1]) return NULL;
+    for (size_t i = 0; i < nlang; i++) {
+        if (!langs[i].get) continue;
+        for (size_t j = 0; langs[i].exts[j]; j++)
+            if (!strcmp(dot + 1, langs[i].exts[j])) return &langs[i];
+    }
+    return NULL;
+}
+
+/* The language a filename maps to, whether or not its parser is loaded. */
+static HLLang *lang_known(const char *name) {
+    if (!name) return NULL;
+    const char *dot = strrchr(name, '.');
+    if (!dot || !dot[1]) return NULL;
+    for (size_t i = 0; i < nlang; i++) {
+        for (size_t j = 0; langs[i].exts[j]; j++)
+            if (!strcmp(dot + 1, langs[i].exts[j])) return &langs[i];
+    }
+    return NULL;
+}
+
+/* ------------------------------ parse + color ------------------------------ */
+
+static TSParser *parser;
+static TSTree *tree;
+static uint8_t *classes;
+static size_t classes_len, classes_cap;
+static int s_dirty;
+static HLLang *active;
+
+static const char *const keywords[] = {
+    "and", "as", "assert", "async", "await", "break", "case", "catch",
+    "class", "const", "constexpr", "continue", "def", "default", "delete",
+    "do", "elif", "else", "enum", "except", "export", "extern", "extends",
+    "false", "finally", "fn", "for", "from", "func", "function", "get",
+    "global", "goto", "if", "impl", "import", "in", "include", "inline",
+    "instanceof", "is", "lambda", "let", "loop", "match", "mod", "move",
+    "mut", "namespace", "new", "nonlocal", "not", "null", "nullptr",
+    "of", "operator", "or", "out", "override", "package", "pass", "private",
+    "protected", "public", "pub", "raise", "return", "self", "set", "signed",
+    "sizeof", "static", "struct", "super", "switch", "this", "throw", "true",
+    "try", "type", "typedef", "typename", "union", "unsigned", "unsafe",
+    "use", "using", "var", "virtual", "void", "volatile", "while", "with",
+    "yield", NULL,
+};
+
+static int is_keyword(const char *t) {
+    for (size_t i = 0; keywords[i]; i++)
+        if (!strcmp(t, keywords[i])) return 1;
+    return 0;
+}
+
+/* Exact node-type names worth highlighting. */
+static const struct { const char *t; int cat; } named_map[] = {
+    { "comment", HL_COMMENT },
+    { "line_comment", HL_COMMENT },
+    { "block_comment", HL_COMMENT },
+    { "comment_block", HL_COMMENT },
+    { "string_literal", HL_STRING },
+    { "string", HL_STRING },
+    { "interpreted_string_literal", HL_STRING },
+    { "raw_string_literal", HL_STRING },
+    { "raw_string", HL_STRING },
+    { "char_literal", HL_STRING },
+    { "byte_string_literal", HL_STRING },
+    { "byte_char", HL_STRING },
+    { "template_string", HL_STRING },
+    { "concatenated_string", HL_STRING },
+    { "regex", HL_STRING },
+    { "number_literal", HL_NUMBER },
+    { "integer_literal", HL_NUMBER },
+    { "float_literal", HL_NUMBER },
+    { "decimal_integer_literal", HL_NUMBER },
+    { "hex_integer_literal", HL_NUMBER },
+    { "octal_integer_literal", HL_NUMBER },
+    { "binary_integer_literal", HL_NUMBER },
+    { "unsigned_integer_literal", HL_NUMBER },
+    { "real_literal", HL_NUMBER },
+    { "integer", HL_NUMBER },
+    { "float", HL_NUMBER },
+    { "type_identifier", HL_TYPE },
+    { "primitive_type", HL_TYPE },
+    { "type", HL_TYPE },
+    { "namespace_identifier", HL_NAMESPACE },
+    { "preproc_include", HL_PREPROC },
+    { "preproc_def", HL_PREPROC },
+    { "preproc_call", HL_PREPROC },
+    { "preproc_if", HL_PREPROC },
+    { "preproc_else", HL_PREPROC },
+    { "preproc_endif", HL_PREPROC },
+    { "preproc_directive", HL_PREPROC },
+    { "attribute", HL_PREPROC },
+    { "decorator", HL_PREPROC },
+    { "macro_invocation", HL_MACRO },
+    { "storage_class", HL_KEYWORD },
+    { "label", HL_LABEL },
+    { "true", HL_CONST },
+    { "false", HL_CONST },
+    { "null", HL_CONST },
+    { "boolean_literal", HL_CONST },
+    { NULL, HL_NONE },
+};
+
+static int hl_lookup(const char *t) {
+    for (size_t i = 0; named_map[i].t; i++)
+        if (!strcmp(t, named_map[i].t)) return named_map[i].cat;
+    return HL_NONE;
+}
+
+static int hl_classify(TSNode n) {
+    const char *t = rt.node_type(n);
+    if (rt.node_is_named(n)) {
+        int c = hl_lookup(t);
+        if (c) return c;
+        if (strstr(t, "string")) return HL_STRING;
+        if (strstr(t, "integer") || strstr(t, "float") ||
+            strstr(t, "number") || strstr(t, "real"))
+            return HL_NUMBER;
+        if (!strcmp(t, "identifier") || !strcmp(t, "name") ||
+            !strcmp(t, "field_identifier")) {
+            TSNode p = rt.node_parent(n);
+            if (p.id) {
+                const char *pt = rt.node_type(p);
+                if (strstr(pt, "function") || strstr(pt, "method") ||
+                    strstr(pt, "call"))
+                    return HL_FUNC;
+                if (strstr(pt, "type"))
+                    return HL_TYPE;
+            }
+            return HL_NONE;
+        }
+        if (is_keyword(t)) return HL_KEYWORD;
+        return HL_NONE;
+    }
+    /* unnamed leaf: t is the literal token text */
+    if (t[0] == '\0') return HL_NONE;
+    if (isalpha((unsigned char)t[0]))
+        return is_keyword(t) ? HL_KEYWORD : HL_NONE;
+    if (isdigit((unsigned char)t[0])) return HL_NUMBER;
+    if (strspn(t, "+-*/%=<>!&|^~?:") == strlen(t)) return HL_OP;
+    return HL_NONE;
+}
+
+static void hl_walk(TSNode n) {
+    uint32_t s = rt.node_start_byte(n), e = rt.node_end_byte(n);
+    int c = hl_classify(n);
+    if (c != HL_NONE && e > s && s < classes_len) {
+        size_t nbytes = e - s;
+        if (s + nbytes > classes_len) nbytes = classes_len - s;
+        memset(classes + s, c, nbytes);
+    }
+    uint32_t nc = rt.node_child_count(n);
+    for (uint32_t i = 0; i < nc; i++)
+        hl_walk(rt.node_child(n, i));
+}
+
+/* -------------------------------- palette ---------------------------------- */
+
+int hl_color(int cat) {
+    static const int pal[HL_COUNT] = {
+        -1,        /* HL_NONE */
+        204,       /* HL_KEYWORD red */
+        81,        /* HL_TYPE light blue */
+        77,        /* HL_STRING green */
+        246,       /* HL_COMMENT gray */
+        180,       /* HL_NUMBER tan */
+        221,       /* HL_FUNC yellow */
+        208,       /* HL_PREPROC orange */
+        250,       /* HL_OP light gray */
+        141,       /* HL_CONST purple */
+        75,        /* HL_FIELD blue */
+        81,        /* HL_NAMESPACE light blue */
+        152,       /* HL_PARAM gray blue */
+        209,       /* HL_LABEL orange red */
+        172,       /* HL_MACRO orange */
+        250,       /* HL_PUNCT light gray */
+        203,       /* HL_SPECIAL red */
+    };
+    if (cat <= 0 || cat >= HL_COUNT) return -1;
+    return pal[cat];
+}
+
+/* -------------------------------- public API ------------------------------- */
+
+int hl_runtime_ok(void) { return rt_ok; }
+int hl_lang_count(void) { return lang_loaded; }
+int hl_active(void) { return rt_ok && active && active->get; }
+
+/* If highlighting can't run for a file of this name, return a short, static
+ * message saying what to install; otherwise NULL. */
+const char *hl_hint(const char *name) {
+    if (!rt_ok) return "tree-sitter runtime not found; install libtree-sitter";
+    HLLang *k = lang_known(name);
+    if (!k) return NULL;             /* no parser for this file type */
+    if (k->get) return NULL;         /* parser available: highlighting works */
+    static char msg[128];
+    snprintf(msg, sizeof msg,
+             "syntax: no tree-sitter parser for %s; install lib%s-tree-sitter",
+             k->name, k->name);
+    return msg;
+}
+
+void hl_dirty(void) { s_dirty = 1; }
+
+void hl_init(void) {
+    rt_load();
+    if (!rt_ok) return;
+    parser = rt.parser_new();
+    if (!parser) return;
+    langs = lang_tab;
+    nlang = sizeof lang_tab / sizeof lang_tab[0];
+    char sym[128];
+    for (size_t i = 0; i < nlang; i++) {
+        for (size_t j = 0; langs[i].libs[j]; j++) {
+            void *dl = try_dlopen(langs[i].libs[j]);
+            if (!dl) continue;
+            snprintf(sym, sizeof sym, "tree_sitter_%s", langs[i].name);
+            langs[i].get = (const TSLanguage *(*)(void))dlsym_checked(dl, sym);
+            if (langs[i].get) {
+                langs[i].dl = dl;
+                lang_loaded++;
+                break;
+            }
+            dlclose(dl);
+        }
+    }
+}
+
+const uint8_t *hl_classes(size_t *len) {
+    if (len) *len = classes_len;
+    return classes;
+}
+
+void hl_update(Buffer *buf) {
+    if (!s_dirty) return;
+    s_dirty = 0;
+    if (!rt_ok || !parser) return;
+    HLLang *l = lang_for_ext(buf->name);
+    if (l != active) {
+        active = l;
+        if (!l || !rt.parser_set_language(parser, l->get())) {
+            active = NULL;
+            if (tree) { rt.tree_delete(tree); tree = NULL; }
+            return;
+        }
+    }
+    if (!active) return;
+
+    size_t len = gb_len(&buf->gb);
+    if (len > 0x7fffffffu) return; /* tree-sitter takes uint32 lengths */
+    char *src = gb_slice(&buf->gb, 0, len);
+    if (tree) { rt.tree_delete(tree); tree = NULL; }
+    tree = rt.parser_parse_string(parser, NULL, src, (uint32_t)len);
+    free(src);
+    if (!tree) return;
+
+    if (classes_cap < len) {
+        classes_cap = len ? len : 1;
+        classes = realloc(classes, classes_cap);
+    }
+    classes_len = len;
+    if (len) {
+        memset(classes, 0, len);
+        hl_walk(rt.tree_root_node(tree));
+    }
+}
