+/* --------------------------- multiple cursors ui --------------------------- */
+
+/* Copy the word at the primary cursor into E.mword. */
+static void mc_grab_word(void) {
+    size_t len = gb_len(&E.buf.gb);
+    size_t i = E.cur, s;
+    while (i < len) {
+        char c = gb_at(&E.buf.gb, i);
+        if (isalnum((unsigned char)c) || c == '_') break;
+        i++;
+    }
+    s = i;
+    while (i < len) {
+        char c = gb_at(&E.buf.gb, i);
+        if (!isalnum((unsigned char)c) && c != '_') break;
+        i++;
+    }
+    E.mword_len = i - s;
+    if (E.mword_len > sizeof E.mword - 1) E.mword_len = sizeof E.mword - 1;
+    for (size_t j = 0; j < E.mword_len; j++) E.mword[j] = gb_at(&E.buf.gb, s + j);
+    E.mword[E.mword_len] = '\0';
+}
+
+static void mc_enable(void) {
+    E.mcur = malloc(sizeof(size_t));
+    E.mcur[0] = E.cur;
+    E.ncur = 1;
+    E.mcap = 1;
+    E.m_active = 1;
+    E.m_primary = 0;
+    mc_grab_word();
+    edit_set_status("multi-cursor: 1  (<space>c = add next, <space>C = all, esc = done)");
+}
+
+/* Add a cursor if it is not already present; makes it the primary. */
+static int mc_add(size_t pos) {
+    for (size_t i = 0; i < E.ncur; i++)
+        if (E.mcur[i] == pos) return 0;
+    if (E.ncur == E.mcap) {
+        E.mcap = E.mcap ? E.mcap * 2 : 8;
+        E.mcur = realloc(E.mcur, E.mcap * sizeof(size_t));
+    }
+    E.mcur[E.ncur++] = pos;
+    E.m_primary = E.ncur - 1;
+    E.cur = pos;
+    return 1;
+}
+
+/* <space>c: activate, or add the next occurrence of the word. */
+void cmd_mc_add_next(void) {
+    if (!E.m_active) { mc_enable(); return; }
+    if (!E.mword_len) { edit_set_status("no word under cursor"); return; }
+    size_t maxpos = 0;
+    for (size_t i = 0; i < E.ncur; i++)
+        if (E.mcur[i] > maxpos) maxpos = E.mcur[i];
+    size_t len = gb_len(&E.buf.gb);
+    size_t hit = (size_t)-1;
+    if (maxpos + E.mword_len <= len)
+        hit = gb_find(&E.buf.gb, E.mword, E.mword_len, maxpos + E.mword_len);
+    if (hit == (size_t)-1)
+        hit = gb_find(&E.buf.gb, E.mword, E.mword_len, 0);
+    if (hit == (size_t)-1) { edit_set_status("no more matches"); return; }
+    mc_add(hit);
+    edit_set_status("multi-cursor: %zu  (<space>c = add next, <space>C = all, esc = done)", E.ncur);
+}
+
+/* <space>C: add a cursor on every occurrence of the word. */
+void cmd_mc_add_all(void) {
+    if (!E.m_active) mc_enable();
+    if (!E.mword_len) { edit_set_status("no word under cursor"); return; }
+    size_t len = gb_len(&E.buf.gb);
+    size_t from = 0, added = 0;
+    while (from <= len) {
+        size_t hit = gb_find(&E.buf.gb, E.mword, E.mword_len, from);
+        if (hit == (size_t)-1) break;
+        if (mc_add(hit)) added++;
+        from = hit + E.mword_len;
+    }
+    edit_set_status("multi-cursor: %zu cursor(s) (%zu added)", E.ncur, added);
+}
+
+/* <space>x: leave multi-cursor mode. */
+void cmd_mc_exit(void) {
+    if (!E.m_active) return;
+    mc_exit();
+    edit_set_status("multi-cursor off");
+}
