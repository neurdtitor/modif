+/* ----------------------------- multiple cursors ---------------------------- */
+
+/* While E.m_active, editing applies to every cursor in E.mcur[] at once and
+ * motions move them all. <space>c activates multi-cursor and then keeps
+ * adding the next occurrence of the word under the cursor; <space>C adds all
+ * occurrences at once; Esc exits. */
+
+static int mc_inside(void) { return E.m_active; }
+
+static void mc_exit(void) {
+    free(E.mcur);
+    E.mcur = NULL;
+    E.ncur = E.mcap = 0;
+    E.m_active = 0;
+    E.m_primary = 0;
+    E.mword_len = 0;
+}
+
+/* Sort mc_order[] so cursors are visited in descending buffer position, which
+ * keeps earlier positions valid while inserting/deleting. */
+static size_t *mc_order;
+static size_t mc_order_cap;
+
+static void mc_order_by_pos(void) {
+    if (mc_order_cap < E.ncur) {
+        mc_order_cap = E.ncur;
+        mc_order = realloc(mc_order, mc_order_cap * sizeof(size_t));
+    }
+    for (size_t i = 0; i < E.ncur; i++) mc_order[i] = i;
+    for (size_t i = 1; i < E.ncur; i++) {
+        size_t v = mc_order[i], j = i;
+        while (j > 0 && E.mcur[mc_order[j - 1]] < E.mcur[v]) {
+            mc_order[j] = mc_order[j - 1];
+            j--;
+        }
+        mc_order[j] = v;
+    }
+}
+
+static void mc_insert(const char *s, size_t n) {
+    if (!n) return;
+    mc_order_by_pos();
+    for (size_t i = 0; i < E.ncur; i++) {
+        size_t k = mc_order[i];
+        size_t p = E.mcur[k];
+        rec_insert(p, s, n);
+        buf_insert(&E.buf, p, s, n);
+        E.mcur[k] = p + n;
+        /* edits below a cursor shift it forward; edits above leave it alone */
+        for (size_t j = 0; j < E.ncur; j++)
+            if (j != k && E.mcur[j] > p) E.mcur[j] += n;
+    }
+    E.cur = E.mcur[E.m_primary];
+    E.dirty = 1;
+    hl_dirty();
+}
+
+/* Delete [p - before, p - before + n) at each cursor. */
+static void mc_delete(size_t before, size_t n) {
+    mc_order_by_pos();
+    size_t blen = gb_len(&E.buf.gb);
+    for (size_t i = 0; i < E.ncur; i++) {
+        size_t k = mc_order[i];
+        size_t p = E.mcur[k];
+        if (p < before) continue;
+        size_t s = p - before;
+        if (s >= blen) continue;
+        size_t e = s + n;
+        if (e > blen) e = blen;
+        if (e <= s) continue;
+        char *sl = gb_slice(&E.buf.gb, s, e - s);
+        rec_delete(s, sl, e - s);
+        free(sl);
+        buf_delete(&E.buf, s, e - s);
+        E.mcur[k] = s;
+        for (size_t j = 0; j < E.ncur; j++) {
+            if (j == k) continue;
+            if (E.mcur[j] >= e) E.mcur[j] -= (e - s);
+            else if (E.mcur[j] > s) E.mcur[j] = s;
+        }
+    }
+    E.cur = E.mcur[E.m_primary];
+    E.dirty = 1;
+    hl_dirty();
+}
+
+/* Insert at every cursor, applying each edit in descending position order. */
 static void ed_insert_chars(size_t pos, const char *s, size_t n) {
+    if (mc_inside()) { mc_insert(s, n); return; }
     rec_insert(pos, s, n);
     buf_insert(&E.buf, pos, s, n);
     E.dirty = 1;
